<?xml version="1.0"?>
<package format="3">
  <name>m20_gazebo</name>
  <version>0.1.0</version>
  <description>Gazebo Classic simulation of the DeepRobotics M20 with a drdds bridge matching the official MuJoCo bridge</description>
  <maintainer email="dev@example.com">m20 dev</maintainer>
  <license>BSD-3-Clause</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>drdds</depend>
  <depend>gazebo_ros</depend>
  <depend>gazebo_dev</depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
    <gazebo_ros gazebo_model_path="${prefix}/.." gazebo_plugin_path="${prefix}/../../lib"/>
  </export>
</package>
