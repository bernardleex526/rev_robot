should_skip_service() {
    local -a endings=($1)  
    local -a ips=()
    local ip last_byte

    echo "  " 
    echo "=== 开始IP检查 ==="
    while IFS= read -r line; do
        ips+=("$line")
    done < <(ip -o -4 addr show 2>/dev/null | 
             awk '!/^[0-9]+: (lo|docker|veth)/ && $4 !~ /^127\./{print $4}' | 
             cut -d'/' -f1)
    
    if [ ${#ips[@]} -eq 0 ]; then
        echo "警告: 未检测到有效IP地址"
    else
        echo "检测到IP地址:"
        for ip in "${ips[@]}"; do
            echo " - $ip"
        done
    fi
    
    # 检查IP是否在黑名单
    for ip in "${ips[@]}"; do
        last_byte=${ip##*.}  
        
        if ! [[ "$last_byte" =~ ^[0-9]+$ ]]; then
            echo "警告: IP [$ip] 最后一段不是数字，跳过检查"
            continue
        fi
        
        for ending in "${endings[@]}"; do
            if [ "$last_byte" == "$ending" ]; then
                return 1
            fi
        done
    done
    
    echo "无授权IP"
    return 0 
}

start_server() {
    if ! should_skip_service "${START_IP[*]}"; then
        echo "启动 $SERVICE_NAME 服务..."
        if systemctl disable "$SERVICE_NAME.service" && systemctl restart "$SERVICE_NAME.service"; then
            echo "$SERVICE_NAME 服务启动成功"
        else
            echo "$SERVICE_NAME 服务启动失败！"
            exit 1
        fi
    else
        echo "跳过 $SERVICE_NAME 服务 (IP受限)"
    fi
}

