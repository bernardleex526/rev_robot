#!/bin/bash
set -e

echo "rob_bag: postrm called with: $1"

case "$1" in
    purge)
        # 完全清除配置和数据
        echo "rob_bag: Purging all configuration and data..."
        
        # 删除服务链接
        if [ -f "/etc/systemd/system/rob_bag.service" ]; then
            rm -f /etc/systemd/system/rob_bag.service
            echo "rob_bag: Removed service link"
        fi
        
        # 重新加载systemd
        systemctl daemon-reload 2>/dev/null || true
        systemctl reset-failed 2>/dev/null || true
        
        # 提示用户手动删除数据目录(出于安全考虑不自动删除)
        echo "rob_bag: 数据目录 /var/opt/robot/data/rob_bag 已被保留"
        echo "rob_bag: 日志目录 /var/opt/robot/log 已被保留"
        echo "rob_bag: 配置目录 /opt/robot/etc 已被保留"
        echo "rob_bag: 如需完全删除数据，请手动执行:"
        echo "  sudo rm -rf /var/opt/robot/data/rob_bag"
        echo "  sudo rm -rf /var/opt/robot/log"
        echo "  sudo rm -rf /opt/robot/etc"
        ;;
        
    remove|upgrade|failed-upgrade|abort-install)
        # 正常卸载或升级后，只删除服务链接
        echo "rob_bag: Removing service links..."
        
        if [ -f "/etc/systemd/system/rob_bag.service" ]; then
            rm -f /etc/systemd/system/rob_bag.service
            echo "rob_bag: Removed service link"
        fi
        
        # 重新加载systemd
        systemctl daemon-reload 2>/dev/null || true
        systemctl reset-failed 2>/dev/null || true
        ;;
        
    *)
        echo "rob_bag: postrm called with unknown argument: $1" >&2
        exit 1
        ;;
esac

exit 0


