cd /opt/robot/scripts/board_resources/wifi
chmod 777 *
cd /opt/robot/scripts/board_resources/rtsp_service
chmod 777 *
cd /opt/robot/scripts/board_resources/start_ctrl
chmod 777 *
cp /opt/robot/scripts/board_resources/rtsp_service/lib/* /opt/robot/lib/.
cd /opt/robot/lib
ldconfig
cd /opt/robot/scripts/board_resources/storage_space
chmod +x *

cd /opt/robot/scripts/board_resources/rtsp_service/
mv SM_USB_107X_0.json.bak  SM_USB_107X_0.json
mv SM_USB_107X_1.json.bak  SM_USB_107X_1.json
mv SM_USB_107X_2.json.bak  SM_USB_107X_2.json
mv SM_USB_107X_3.json.bak  SM_USB_107X_3.json
mv mediamtx.yml.bak mediamtx.yml
#mv push_video.sh.bak push_video.sh


