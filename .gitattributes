# Git LFS: only patterns that actually exceed GitHub's 100 MB/file hard limit.
# Kept deliberately narrow to conserve the (free-tier) LFS storage quota.
*.db3      filter=lfs diff=lfs merge=lfs -text
*.tar.bz2  filter=lfs diff=lfs merge=lfs -text
*.gbf      filter=lfs diff=lfs merge=lfs -text
*.rep       filter=lfs diff=lfs merge=lfs -text
